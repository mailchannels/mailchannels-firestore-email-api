{
  "name": "@mailchannels/firestore-email-api",
  "version": "0.1.0-dev.0",
  "description": "Firestore outbox function kit for the MailChannels Email API",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "firestore.rules",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:emulator": "npm run build && node scripts/emulator.cjs",
    "prepack": "npm run build",
    "test:package": "node scripts/packed-consumer.cjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "peerDependencies": {
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "firebase-tools": "15.32.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mailchannels/mailchannels-firestore-email-api.git"
  },
  "homepage": "https://github.com/mailchannels/mailchannels-firestore-email-api#readme",
  "bugs": {
    "url": "https://github.com/mailchannels/mailchannels-firestore-email-api/issues"
  }
}
